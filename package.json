{
  "name": "kuro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build:e2e": "node scripts/build-e2e.mjs",
