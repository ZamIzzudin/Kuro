    "exceljs": "^4.4.0",
    "lucide-react": "^1.47.0",
    "minio": "^8.0.7",
    "next": "14.2.25",
    "nodemailer": "^10.0.10",
    "puppeteer-core": "^23.11.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.15.4",
    "swr": "^2.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
