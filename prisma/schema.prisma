// Kuro — Prisma schema
// Struktur: Project → Sprint → Task → Subtask
//   Sprint  : timebox (satu aktif per project); di luar sprint = Backlog
//   Task    : unit "cerita" (story) — metadata bisnis + brief + assignee pool
//   Subtask : unit kerja terdalam — tempat freelancer clock in/out

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Enums =====

enum Role {
  admin
  project_manager
  freelancer
}

enum TaskStatus {
  todo
  in_progress
  review
  done
  cancelled
}

enum Priority {
  low
  medium
  high
}

enum SprintStatus {
  planned
  active
  completed
}

enum CorrectionStatus {
  pending
  approved
  rejected
}

// ===== Models =====

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Nama lengkap (ditampilkan di mana-mana)
  name         String
  // Username unik untuk login/identitas; opsional agar user lama tetap valid
  username     String?  @unique
  // Foto profil (object key di MinIO); null = pakai avatar inisial
  avatarKey    String?
  passwordHash String
  role         Role     @default(freelancer)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taskAssignments     TaskAssignee[]
  createdTasks        Task[]               @relation("TaskCreator")
  assignedSubtasks    Subtask[]            @relation("SubtaskAssignee")
  createdSprints      Sprint[]             @relation("SprintCreator")
  timeEntries         TimeEntry[]
  correctionsFiled    CorrectionRequest[]  @relation("CorrectionRequestor")
  correctionsReviewed CorrectionRequest[]  @relation("CorrectionReviewer")
  activityLogs        ActivityLog[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  requestersCreated   Requester[]
  periodsLocked       PeriodLock[]
  projectMemberships  ProjectMember[]
  taskAttachments     TaskAttachment[]     @relation("TaskAttachmentUploader")
  subtaskAttachments  SubtaskAttachment[]  @relation("SubtaskAttachmentUploader")
}

model Project {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  // Banner: gambar (object key di MinIO) ATAU warna solid. Keduanya opsional.
  bannerKey   String?
  bannerColor String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  tasks       Task[]
  sprints     Sprint[]
  members     ProjectMember[]
  requesters  ProjectRequester[]
}

// Assign freelancer ke project — dasar dropdown project di sidebar freelancer
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// Requester yang terikat pada sebuah project
model ProjectRequester {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requesterId String
  requester   Requester @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([projectId, requesterId])
  @@index([requesterId])
}

model WorkType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Requester {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  // Q6: tambah requester hanya Admin
  creatorId String?
  creator   User?             @relation(fields: [creatorId], references: [id])
  createdAt DateTime          @default(now())
  tasks     Task[]
  projects  ProjectRequester[]
}

// ===== Sprint (menggantikan Group Task) =====
// Timebox per project. Satu sprint aktif per project; di luar sprint = Backlog.
model Sprint {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  name        String       @db.VarChar(120)
  // Sprint Goal — opsional, format Markdown
  goal        String?
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  status      SprintStatus @default(planned)
  createdById String
  createdBy   User         @relation("SprintCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tasks   Task[]
  history TaskSprintHistory[]

  @@index([projectId, status])
  @@index([projectId, startDate])
}

/**
 * Riwayat keanggotaan task di sebuah sprint (audit permanen, bukan hanya ActivityLog).
 * Saat sprint ditutup dan task belum selesai → `leftAt` diisi, `leftReason` = carried_over.
 */
model TaskSprintHistory {
  id            String      @id @default(uuid())
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sprintId      String
  sprint        Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now())
  leftAt        DateTime?
  // carried_over | moved | removed | sprint_completed
  leftReason    String?
  // status task saat dilepas dari sprint (snapshot)
  statusAtLeave TaskStatus?
  note          String?

  @@index([taskId])
  @@index([sprintId])
}

// ===== Task (unit "cerita"/story) =====
model Task {
  id             String     @id @default(uuid())
  title          String     @db.VarChar(150)
  // Deskripsi/brief — format Markdown
  description    String?
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id])
  // NULL = Backlog (di luar sprint)
  sprintId       String?
  sprint         Sprint?    @relation(fields: [sprintId], references: [id])
  workTypeId     String
  workType       WorkType   @relation(fields: [workTypeId], references: [id])
  requesterId    String
  requester      Requester  @relation(fields: [requesterId], references: [id])
  requestDate    DateTime   @db.Date
  priority       Priority   @default(medium)
  deadlineAt     DateTime
  estimatedHours Decimal?   @db.Decimal(5, 1) // kelipatan 0,5
  status         TaskStatus @default(todo)
  // Penanda task ini lahir sebagai REVISI dari task lain (bukan task biasa).
  // Statusnya tetap `todo` agar bisa diambil di sprint berikutnya.
  isRevision     Boolean    @default(false)
  // Task asal yang diminta revisi (self-relation). NULL = task biasa.
  revisionOfId   String?
  revisionOf     Task?      @relation("TaskRevision", fields: [revisionOfId], references: [id])
  revisions      Task[]     @relation("TaskRevision")
  // Catatan alasan revisi (diisi admin saat membuat revisi).
  revisionNote   String?
  createdById    String
  createdBy      User       @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assignees     TaskAssignee[]
  subtasks      Subtask[]
  attachments   TaskAttachment[]
  sprintHistory TaskSprintHistory[]

  @@index([status, deadlineAt])
  @@index([projectId])
  @@index([sprintId])
  @@index([requesterId])
  @@index([revisionOfId])
}

// Assign freelancer ke sebuah Task (multi-assignee) — pool yang boleh mengerjakan subtask
model TaskAssignee {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

// ===== Subtask (unit kerja terdalam) =====
model Subtask {
  id             String     @id @default(uuid())
  taskId         String
  task           Task       @relation(fields: [taskId], references: [id])
  title          String     @db.VarChar(150)
  // Deskripsi — format Markdown
  description    String?
  // NULL = bisa diklaim (bucket bersama)
  assigneeId     String?
  assignee       User?      @relation("SubtaskAssignee", fields: [assigneeId], references: [id])
  status         TaskStatus @default(todo)
  position       Int        @default(0)
  estimatedHours Decimal?   @db.Decimal(5, 1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  timeEntries TimeEntry[]
  attachments SubtaskAttachment[]

  @@index([taskId, position])
  @@index([assigneeId, status])
}

model TimeEntry {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  subtaskId  String
  subtask    Subtask   @relation(fields: [subtaskId], references: [id])
  clockInAt  DateTime // UTC
  clockOutAt DateTime? // NULL = sesi aktif
  note       String? // wajib saat clock out (min. 10 karakter); opsional saat switch (Q4)
  taskStatusAtCheckout TaskStatus?
  createdAt  DateTime  @default(now())

  corrections CorrectionRequest[]
  attachments TimeEntryAttachment[]

  @@index([userId, clockOutAt])
  @@index([subtaskId])
  @@index([clockInAt])
  // NOTE: partial unique index "satu sesi aktif per user" (business rule #2)
  // dibuat via prisma/constraints.sql (Prisma tidak mendukung partial index di schema)
}

// Lampiran Task (brief/referensi) — diunggah admin saat membuat/mengubah task
model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  objectKey    String
  contentType  String
  size         Int
  uploadedById String
  uploadedBy   User     @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
}

// Lampiran Subtask (hasil/lampiran pekerjaan)
model SubtaskAttachment {
  id           String   @id @default(uuid())
  subtaskId    String
  subtask      Subtask  @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  fileName     String
  objectKey    String
  contentType  String
  size         Int
  uploadedById String
  uploadedBy   User     @relation("SubtaskAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([subtaskId])
}

// Lampiran saat clock out (berkas/gambar) — milik sebuah time entry
model TimeEntryAttachment {
  id          String    @id @default(uuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  fileName    String
  objectKey   String
  contentType String
  size        Int
  createdAt   DateTime  @default(now())

  @@index([timeEntryId])
}

model CorrectionRequest {
  id             String           @id @default(uuid())
  timeEntryId    String
  timeEntry      TimeEntry        @relation(fields: [timeEntryId], references: [id])
  requestedById  String
  requestedBy    User             @relation("CorrectionRequestor", fields: [requestedById], references: [id])
  // nilai usulan (nilai lama ada di timeEntry; audit lengkap di ActivityLog)
  newClockInAt   DateTime?
  newClockOutAt  DateTime?
  newSubtaskId   String?
  reason         String
  status         CorrectionStatus @default(pending)
  reviewedById   String?
  reviewedBy     User?            @relation("CorrectionReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String // clock_in | clock_out | switch_task | task_status_changed | ... (append-only)
  entityType  String?
  entityId    String?
  oldValue    Json?
  newValue    Json?
  description String
  createdAt   DateTime @default(now()) // UTC

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([userId, createdAt(sort: Desc)])
}

model PeriodLock {
  id         String   @id @default(uuid())
  year       Int
  month      Int
  lockedById String
  lockedBy   User     @relation(fields: [lockedById], references: [id])
  note       String?
  lockedAt   DateTime @default(now())

  @@unique([year, month])
}

model Session {
  id         String   @id // sha256(token dari cookie)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  expiresAt  DateTime // sliding 8 jam
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id // sha256(token dari email)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime // 1 jam
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
