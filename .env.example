# ===== Database =====
# Lokal (docker-compose.dev.yml): postgresql://notu:notu@localhost:5432/notu
# Dokploy: isi dengan connection string service Postgres
DATABASE_URL=postgresql://notu:notu@localhost:5432/notu

# ===== App =====
# Domain publik — dipakai untuk link reset password (O1)
APP_URL=http://localhost:3000
# Reserved untuk kebutuhan signing di masa depan
SESSION_SECRET=

# ===== SMTP (reset password) =====
# Kosongkan di dev → email reset dicetak ke console server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kuro <no-reply@kuro.local>

# ===== Export PDF (Puppeteer) =====
# Di Docker/Dokploy sudah otomatis ke /usr/bin/chromium-browser (lihat Dockerfile).
# Di lokal, biarkan kosong agar Kuro mencari Chrome/Edge otomatis;
# isi bila ingin memakai executable tertentu.
# PUPPETEER_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# ===== Penyimpanan objek / MinIO (banner project) =====
# Dipakai untuk menyimpan GAMBAR banner project. Banner WARNA tetap bisa dipakai tanpa ini.
# Bila dikosongkan, form project menampilkan pesan bahwa storage belum dikonfigurasi.
#
# Cara menyiapkan di server MinIO Anda:
#   1) Buat access key khusus aplikasi: MinIO Console → Identity → Access Keys → Create
#      (centang/izinkan policy pada bucket yang dipakai, mis. bucket "notu").
#   2) Atau pakai policy minimal berikut untuk user tersebut:
#      { "Version":"2012-10-17", "Statement":[{ "Effect":"Allow",
#        "Action":["s3:GetBucketLocation","s3:ListBucket"], "Resource":["arn:aws:s3:::notu"] },
#        { "Effect":"Allow",
#          "Action":["s3:PutObject","s3:GetObject","s3:DeleteObject"],
#          "Resource":["arn:aws:s3:::notu/*"] }] }
#   3) Bucket akan dibuat otomatis oleh Kuro bila belum ada.
#
# MINIO_ENDPOINT  host tanpa skema & tanpa path, mis:
#                   - di belakang reverse proxy HTTPS: s3.notu.dev
#                   - langsung ke server: 150.109.22.117
# MINIO_PORT      KOSONGKAN untuk memakai default (443 bila MINIO_USE_SSL=true, 9000 bila false).
#                 Isi hanya bila MinIO di port non-standar, mis. 9000 atau 8443.
# MINIO_USE_SSL   true bila diakses lewat HTTPS (s3.notu.dev), false untuk http langsung.
# MINIO_BUCKET    default "notu"
#
# Contoh A — domain HTTPS via reverse proxy (paling umum):
#   MINIO_ENDPOINT=s3.notu.dev
#   MINIO_PORT=
#   MINIO_USE_SSL=true
# Contoh B — akses langsung ke MinIO tanpa TLS:
#   MINIO_ENDPOINT=150.109.22.117
#   MINIO_PORT=9000
#   MINIO_USE_SSL=false
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=notu

# ===== Seed awal (npm run db:seed) =====
INITIAL_ADMIN_EMAIL=admin@notu.local
INITIAL_ADMIN_PASSWORD=admin12345
# SEED_DEMO=1 → tambah akun freelancer demo (freelancer@notu.local / freelancer12345)
SEED_DEMO=1
